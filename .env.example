# --- Supabase (Postgres) ---
# Project settings → API. Kies bij aanmaken een EU-regio (AVG, zie sectie 13).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Content-editor (/beheer) ---
ADMIN_PASSWORD=
# Willekeurige lange random string, gebruikt om de sessie-cookie te ondertekenen.
ADMIN_SESSION_SECRET=

# --- Google Sheets sync (sectie 11) ---
GOOGLE_SHEETS_CLIENT_EMAIL=
GOOGLE_SHEETS_PRIVATE_KEY=
GOOGLE_SHEETS_SPREADSHEET_ID=

# --- E-mail (Resend, sectie 12) ---
RESEND_API_KEY=
EMAIL_FROM="Revenue Growth Scan <scan@jouwdomein.nl>"
EMAIL_SENDER_NAME="Maarten"
# TODO (sectie 15.3): agendalink voor de koffie-CTA (Calendly / Cal.com)
COFFEE_AGENDA_URL=https://cal.com/jouw-agenda
# TODO (sectie 15.6): kies vertraging voor mail 2 in minuten (0 = direct)
COFFEE_EMAIL_DELAY_MINUTES=0

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_COMPANY_NAME="Jouw Bedrijf"
